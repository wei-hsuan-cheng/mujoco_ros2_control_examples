<mujoco model='door'>
    <worldbody>

        <!-- Parameter definitions: -->
        <!-- distance_base_to_door = 0.6 [m] -->
        <!-- door_width: 0.6 [m] (half-width 0.3) -->
        <!-- door_thickness: 0.02 [m] (half-thickness 0.02) -->
        <!-- door_height: 1.0 [m] (half-height 0.5) -->
        <!-- door_latch_offset: z=0.0 [m] -->
        <!-- door_latch_radius: 0.01 [m] -->

        <body name="frame" pos="0.6 0.3 0.5" quat="0.7071068 0 0 -0.7071068" user="1001 0 2002 -0.4 -0.1 0.252 0 0.3 0.5">
            <inertial pos="0.3 0 0" quat="0.5 0.5 0.5 0.5" mass="7.85398" diaginertia="0.923301 0.764585 0.168533" />
            
            <!-- Two vertical posts resting on ground -->
            <!-- Left post (shifted half_door_thickness) -->
            <geom type="box" pos="-0.02 0 0" size="0.02 0.02 0.5" rgba="0 0 1 1"/>
            <!-- Right post (shifted door_width + half_door_thickness) -->
            <geom type="box" pos="0.62 0 0" size="0.02 0.02 0.5" rgba="1 0 0 1"/>
            <site name="S_handle_target" pos="0.75 -0.5 -.18" size="0.02" group='3'/>
            
            <!-- Door panel -->
            <!-- Located at half_door_width  -->
            <body name="door_panel" pos="0.3 0 0">
                <inertial pos="0.0296816 -0.00152345 0" quat="0.7071068 0 0 0.7071068" mass="0.243455" diaginertia="0.0913751 0.0521615 0.043714" />
                
                <!-- Box size: half_door_width x half_door_thickness x half_door_height -->
                <geom type="box" size="0.3 0.02 0.5" friction="1 1 1" />
                
                <!-- Door hinge joint  -->
                <!-- Located at the side of the door panel -->
                <joint name="door_hinge" pos="0.3 0 0" axis="0 0 1" range="0 1.57" damping="0.1" frictionloss="0.2" />
                
                <!-- Door latch  -->
                <!-- Shifted from center: half_door_width - 2 * door_thickness -->
                <body name="door_latch" pos="-0.26 0 0.0">
                    <inertial pos="-0.027762 0.0238544 0" quat="0.365653 0.605347 -0.36522 0.605365" mass="0.353743" diaginertia="0.0483771 0.0410001 0.0211013" />
                    
                    <!-- Door latch joint -->
                    <joint name="door_latch" pos="0 0 0" axis="0 1 0" range="0 1.8" frictionloss="0.5" />
                    
                    <!-- Door latch shapes -->
                    <geom type="cylinder" size="0.01 0.075" quat="0.7071068 0.7071068 0 0" />
                    <!-- Front handle -->
                    <geom type="capsule" size="0.01 0.05" pos="0.05 -0.075 0" quat="0.7071068 0 0.7071068 0" />
                    <!-- Back latch -->
                    <geom type="capsule" size="0.02 0.055" pos="0.0 0.0425 0" quat="0.7071068 0 0.7071068 0" />
                    <site name="S_handle" pos="0.15 -0.15 0" size="0.02" group='3'/>

                </body>

            </body>
            
        </body>

    </worldbody>
</mujoco>
